# setup:local generates an independent local credential and session secret.
DATABASE_URL=postgresql://restaurant_app:CHANGE_ME@127.0.0.1:5432/restaurant_management
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_management_nosql
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ORIGIN=http://127.0.0.1:3000
# For an existing PostgreSQL instance set an administrator connection for setup only:
# PG_ADMIN_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/postgres

NEXT_TELEMETRY_DISABLED=1
# Existing authenticated MongoDB administrator used only for initial project-user provisioning:
# MONGO_ADMIN_URL=mongodb://ADMIN:YOUR_PASSWORD@127.0.0.1:27017/admin
